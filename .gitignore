# Python
__pycache__/
*.py[cod]
*.egg-info/
.eggs/
build/
dist/

# 虚拟环境
.venv/
venv/
env/

# 环境变量(含敏感配置)
.env
.env.local

# 数据与运行产物
data/*.db
data/*.sqlite3
data/*.log
data/backups/
logs/
*.log

# 会话状态(含集思录登录 cookie, 严禁入库)
data/state/

# IDE
.idea/
.vscode/
*.swp
*.swo

# 系统
.DS_Store
Thumbs.db

# 前端
frontend/node_modules/
frontend/dist/
frontend/.vite/
frontend/.dist-next/
frontend/.dist-prev/

# 本地启停脚本运行态(PID与日志)
.runtime/

# SQLite WAL 伴随文件
data/*.db-shm
data/*.db-wal

# pytest 隔离测试的临时数据目录(conftest 约定 .test_ 前缀)
data/.test_*/

# pytest 测试产物(独立目录, 不入库, 见 tests/conftest.py)
.test-artifacts/
